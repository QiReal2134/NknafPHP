# 应用环境
APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=Asia/Shanghai

# ============================================================
# 安全配置 (生产环境必须修改)
# ============================================================

# JWT 配置 (生产环境必须使用 openssl rand -hex 32 生成)
JWT_SECRET=change_me_to_a_random_string_at_least_32_chars_long
JWT_EXPIRES_IN=7d

# CORS 配置
# 生产环境请填写实际域名，多个域名用逗号分隔
ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOW_CREDENTIALS=true

# HSTS 配置 (仅生产环境启用)
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUB_DOMAINS=true
HSTS_PRELOAD=true

# 可信代理 IP 列表 (生产环境配置反向代理服务器 IP)
TRUSTED_PROXIES=127.0.0.1

# 速率限制配置
RATE_LIMIT_API_MAX=60
RATE_LIMIT_API_WINDOW=60
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=900
RATE_LIMIT_REGISTER_MAX=3
RATE_LIMIT_REGISTER_WINDOW=3600

# 上传安全配置
UPLOAD_MAX_WIDTH=4096
UPLOAD_MAX_HEIGHT=4096
UPLOAD_AVATAR_MAX_WIDTH=500
UPLOAD_AVATAR_MAX_HEIGHT=500

# ============================================================
# 服务器配置
# ============================================================
PORT=3000

# ============================================================
# MySQL 数据库配置 (请填写实际值)
# ============================================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_strong_password_here
DB_NAME=blog_db

# 连接池配置
DB_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT=10000
DB_ACQUIRE_TIMEOUT=10000
DB_MAX_IDLE=5
DB_IDLE_TIMEOUT=60000

# JWT 配置（生产环境必须使用 openssl rand -hex 32 生成）
JWT_SECRET=change_me_to_a_random_string_at_least_32_chars_long
JWT_EXPIRES_IN=7d

# Redis 配置
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# 生产环境建议设置密码
REDIS_PASSWORD=

# ============================================================
# 上传配置
# ============================================================
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# 站点配置
SITE_URL=http://localhost:3000

# 功能开关
REGISTER_ENABLED=false

# ============================================================
# 日志配置
# ============================================================
# 日志级别：DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=DEBUG
