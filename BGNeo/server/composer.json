{"name": "bgneo/server", "description": "BGNeo Blog System - PHP 8.5 Backend", "type": "project", "license": "ISC", "require": {"php": ">=8.5", "nikic/fast-route": "^1.3", "monolog/monolog": "^3.0", "firebase/php-jwt": "^6.10", "vlucas/phpdotenv": "^5.0"}, "require-dev": {"phpunit/phpunit": "^11.0"}, "suggest": {"ext-redis": "Required for rate limiting, view count caching, and JWT blacklist. Falls back to DB when unavailable."}, "autoload": {"psr-4": {"App\\": "src/"}, "files": ["config/helpers.php"]}, "autoload-dev": {"psr-4": {"App\\Tests\\": "tests/"}}, "config": {"optimize-autoloader": true, "sort-packages": true, "allow-plugins": {}, "audit": {"abandoned": "ignore", "block-insecure": false}}, "minimum-stability": "stable", "prefer-stable": true, "scripts": {"test": "phpunit", "test:coverage": "phpunit --coverage-html coverage"}}